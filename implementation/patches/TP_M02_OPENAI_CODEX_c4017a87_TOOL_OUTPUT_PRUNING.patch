+            function_output("old", text_for_tokens(30_000, 'o')),
+        ];
+        canonical.extend(protected_budget_pair());
+        canonical.extend(two_boundaries());
+        let before = canonical.clone();
+
+        let request = prune(canonical.clone());
+
+        assert_eq!(canonical, before);
+        assert_ne!(request, before);
+    }
+
+    #[test]
+    fn regenerated_retry_input_receives_the_same_transform_when_reapplied() {
+        let mut canonical = vec![
+            function_call("old", "exec_command", "cat old.txt"),
+            function_output("old", text_for_tokens(30_000, 'o')),
+        ];
+        canonical.extend(protected_budget_pair());
+        canonical.extend(two_boundaries());
+
+        let initial_request = prune(canonical.clone());
+        let regenerated_retry_request = prune(canonical.clone());
+
+        assert_eq!(initial_request, regenerated_retry_request);
+        assert_eq!(
+            body_text(&regenerated_retry_request[1]),
+            Some(PRUNE_PLACEHOLDER)
+        );
+    }
+
+    #[test]
+    fn mutating_or_shell_composed_exec_command_is_not_allowlisted() {
+        let mutation = text_for_tokens(35_000, 'm');
+        let mut items = vec![
+            function_call("mutation", "exec_command", "cat input.txt > output.txt"),
+            function_output("mutation", mutation.clone()),
+            function_call("old", "exec_command", "cat old.txt"),
+            function_output("old", text_for_tokens(30_000, 'o')),
+        ];
+        items.extend(protected_budget_pair());
+        items.extend(two_boundaries());
+
+        let pruned = prune(items);
+        assert_eq!(body_text(&pruned[1]), Some(mutation.as_str()));
+    }
+
+    #[test]
+    fn no_eligible_output_is_unchanged() {
+        let items = vec![
+            function_call("patch", "apply_patch", "*** Begin Patch"),
+            function_output("patch", text_for_tokens(80_000, 'p')),
+            user_message("u1"),
+            user_message("u2"),
+        ];
+        assert_eq!(prune(items.clone()), items);
+    }
+}
