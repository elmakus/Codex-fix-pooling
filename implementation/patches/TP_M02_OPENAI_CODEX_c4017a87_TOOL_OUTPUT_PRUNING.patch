+use std::collections::HashMap;
+use std::collections::hash_map::Entry;
+
+use codex_protocol::DEFAULT_FUNCTION_NAMESPACE;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::ResponseItem;
+
+use crate::context_manager::estimate_item_token_count;
+
+const PRUNE_PROTECT_TOKENS: usize = 40_000;
+const PRUNE_MINIMUM_NET_TOKENS: usize = 20_000;
+const PRUNE_RECENT_USER_BOUNDARIES: usize = 2;
+const PRUNE_PLACEHOLDER: &str = "[Old tool result content cleared]";
+
+#[derive(Clone, Debug)]
+struct CallDescriptor {
+    name: String,
+    namespace: Option<String>,
+    input: String,
+}
+
+pub(crate) fn prune(items: Vec<ResponseItem>) -> Vec<ResponseItem> {
+    let calls = collect_calls(&items);
+    let mut crossed_user_boundaries = 0usize;
+    let mut protected_candidate_tokens = 0usize;
+    let mut replacements = Vec::<(usize, ResponseItem, usize)>::new();
+    let mut net_savings = 0usize;
+
+    for (idx, item) in items.iter().enumerate().rev() {
+        if is_user_input_boundary(item) {
+            crossed_user_boundaries = crossed_user_boundaries.saturating_add(1);
+            continue;
+        }
+        if crossed_user_boundaries < PRUNE_RECENT_USER_BOUNDARIES {
+            continue;
+        }
+
+        let Some(replacement) = replacement_for_candidate(item, &calls) else {
+            continue;
+        };
+        let Some(original_tokens) = estimated_tokens(item) else {
+            continue;
+        };
+
+        // Protect whole outputs until the newest otherwise-eligible budget is satisfied.
+        // This intentionally may retain more than the nominal budget when one output crosses it.
+        if protected_candidate_tokens < PRUNE_PROTECT_TOKENS {
+            protected_candidate_tokens =
+                protected_candidate_tokens.saturating_add(original_tokens);
+            continue;
+        }
+
+        let Some(replacement_tokens) = estimated_tokens(&replacement) else {
+            continue;
+        };
+        let Some(saved_tokens) = original_tokens.checked_sub(replacement_tokens) else {
+            continue;
+        };
+        if saved_tokens == 0 {
+            continue;
+        }
+
+        net_savings = net_savings.saturating_add(saved_tokens);
+        replacements.push((idx, replacement, saved_tokens));
+    }
+
+    if net_savings <= PRUNE_MINIMUM_NET_TOKENS {
+        return items;
+    }
+
+    let mut pruned = items;
+    for (idx, replacement, _) in replacements {
+        pruned[idx] = replacement;
+    }
+    pruned
+}
+
+fn estimated_tokens(item: &ResponseItem) -> Option<usize> {
+    usize::try_from(estimate_item_token_count(item))
+        .ok()
+        .filter(|tokens| *tokens > 0)
+}
+
+fn collect_calls(items: &[ResponseItem]) -> HashMap<String, Option<CallDescriptor>> {
+    let mut calls = HashMap::new();
+    for item in items {
+        let descriptor = match item {
+            ResponseItem::FunctionCall {
+                call_id,
+                name,
+                namespace,
+                arguments,
+                ..
+            } => Some((
+                call_id,
+                CallDescriptor {
+                    name: name.clone(),
+                    namespace: namespace.clone(),
+                    input: arguments.clone(),
+                },
+            )),
+            ResponseItem::CustomToolCall {
+                call_id,
+                name,
+                namespace,
+                input,
+                ..
+            } => Some((
+                call_id,
+                CallDescriptor {
+                    name: name.clone(),
+                    namespace: namespace.clone(),
+                    input: input.clone(),
+                },
+            )),
+            _ => None,
+        };
+        let Some((call_id, descriptor)) = descriptor else {
+            continue;
+        };
+        match calls.entry(call_id.clone()) {
+            Entry::Vacant(entry) => {
+                entry.insert(Some(descriptor));
+            }
+            Entry::Occupied(mut entry) => {
+                // Any duplicate call ID makes the relationship ambiguous, even if both
+                // observed calls happen to carry the same name today.
+                entry.insert(None);
+            }
+        }
+    }
+    calls
+}
+
+fn replacement_for_candidate(
+    item: &ResponseItem,
+    calls: &HashMap<String, Option<CallDescriptor>>,
+) -> Option<ResponseItem> {
+    let (call_id, output_name, output_namespace, output) = match item {
+        ResponseItem::FunctionCallOutput {
+            call_id: Some(call_id),
+            name,
+            namespace,
+            output,
+            ..
+        } => (
+            call_id.as_str(),
+            name.as_deref(),
+            namespace.as_deref(),
+            output,
+        ),
+        ResponseItem::CustomToolCallOutput {
+            call_id,
+            name,
+            output,
+            ..
+        } => (call_id.as_str(), name.as_deref(), None, output),
+        _ => return None,
+    };
+
+    if output.success != Some(true) || !matches!(output.body, FunctionCallOutputBody::Text(_)) {
+        return None;
+    }
+
+    let call = calls.get(call_id)?.as_ref()?;
+    if output_name.is_some_and(|name| name != call.name.as_str()) {
+        return None;
+    }
+    if output_namespace.is_some_and(|namespace| call.namespace.as_deref() != Some(namespace)) {
+        return None;
+    }
+    if !is_replayable_call(call) {
+        return None;
+    }
+
+    let mut replacement = item.clone();
+    match &mut replacement {
+        ResponseItem::FunctionCallOutput { output, .. }
+        | ResponseItem::CustomToolCallOutput { output, .. } => {
+            output.body = FunctionCallOutputBody::Text(PRUNE_PLACEHOLDER.to_string());
+        }
+        _ => return None,
+    }
+    Some(replacement)
+}
+
+fn is_replayable_call(call: &CallDescriptor) -> bool {
+    if !call
+        .namespace
+        .as_deref()
+        .is_none_or(|namespace| namespace == DEFAULT_FUNCTION_NAMESPACE)
+    {
+        return false;
+    }
+
+    match call.name.as_str() {
+        // The initial allowlist is intentionally tiny. exec_command becomes eligible only
+        // when its argument is provably one simple read-only command from the list below.
+        "exec_command" => extract_exec_command(&call.input).is_some_and(is_simple_read_only_command),
+        _ => false,
+    }
+}
+
+fn extract_exec_command(input: &str) -> Option<&str> {
+    let value: serde_json::Value = serde_json::from_str(input).ok()?;
+    value.get("cmd")?.as_str()
+}
+
+fn is_simple_read_only_command(command: &str) -> bool {
+    let command = command.trim();
+    if command.is_empty()
+        || command
+            .chars()
+            .any(|ch| matches!(ch, '\n' | '\r' | ';' | '|' | '&' | '>' | '<' | '`'))
+        || command.contains("$(")
+        || command.contains("${")
+    {
+        return false;
+    }
+
+    let mut words = command.split_whitespace();
+    let Some(executable) = words.next() else {
+        return false;
+    };
+    let executable = executable.rsplit('/').next().unwrap_or(executable);
+
+    match executable {
+        "cat" | "head" | "wc" | "ls" | "pwd" | "stat" | "grep" => true,
+        "tail" => !words.any(|arg| {
+            arg == "-f"
+                || arg.starts_with("-f")
+                || arg == "--follow"
+                || arg.starts_with("--follow=")
+                || arg == "--pid"
+                || arg.starts_with("--pid=")
+        }),
+        "rg" => !words.any(|arg| arg == "--pre" || arg.starts_with("--pre=")),
+        _ => false,
+    }
+}
+
+fn is_user_input_boundary(item: &ResponseItem) -> bool {
+    let ResponseItem::Message {
+        role,
+        internal_chat_message_metadata_passthrough,
+        ..
+    } = item
+    else {
+        return false;
+    };
+    if role != "user" {
+        return false;
+    }
+
+    internal_chat_message_metadata_passthrough
+        .as_ref()
+        .and_then(|metadata| metadata.content_item_kinds.as_ref())
+        .is_none_or(|kinds| kinds.iter().any(|kind| kind.0.starts_with("user.")))
+}
