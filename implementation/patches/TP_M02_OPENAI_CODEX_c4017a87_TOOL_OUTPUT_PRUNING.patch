+        ];
+        items.extend(protected_budget_pair());
+        items.extend(two_boundaries());
+
+        let pruned = prune(items);
+        let ResponseItem::FunctionCallOutput {
+            call_id,
+            name,
+            namespace,
+            output,
+            internal_chat_message_metadata_passthrough,
+            ..
+        } = &pruned[1]
+        else {
+            panic!("expected function call output");
+        };
+        assert_eq!(call_id.as_deref(), Some("old"));
+        assert_eq!(name.as_deref(), Some("exec_command"));
+        assert_eq!(namespace, &None);
+        assert_eq!(output.success, Some(true));
+        assert_eq!(
+            output.body,
+            FunctionCallOutputBody::Text(PRUNE_PLACEHOLDER.to_string())
+        );
+        assert_eq!(internal_chat_message_metadata_passthrough, &Some(metadata));
+    }
